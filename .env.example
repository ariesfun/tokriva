# 凭证模板：复制为 .env 后填入真实值。.env 已在 .gitignore 中。
# 只写环境变量名到代码里，绝不把 key 写进仓库。

# OpenAI 兼容 chat/completions 的端点
LIGHTVELA_API_KEY=
LIGHTVELA_BASE_URL=https://token.lightvela.ai/v1

# AMD 官方直连（base_url 已硬编码在 run.py，无需在此配置地址）
AMD_BEARER_TOKEN=

# 需要走代理的端点
PACKET_API_KEY=
PACKET_BASE_URL=https://api.packet.ai/v1
PACKET_MODEL=

# OpenRouter 聚合网关（一个 Key 覆盖多家服务商的免费模型，用 :free 后缀）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# 以下 7 家为待接入平台（详见 docs/2026-11-23_免费平台接入适配清单.md）
# 注意：仅填 Key 不会生效——还需在 hub/run.py 的 ENDPOINTS 里登记端点，
#       并用 GET /models 冒烟确认 base_url 与模型 ID 后才能探测。
# ---------------------------------------------------------------------------

# Google AI Studio / Gemini（★★★★★，限额按项目不按 Key）
GEMINI_API_KEY=

# Groq（★★★★★，限额按组织，需确认 base_url 的 OpenAI 兼容路径）
GROQ_API_KEY=

# Hugging Face Router（★★★★☆，每月额度极小，仅做极少量 L2）
HF_TOKEN=

# Cloudflare Workers AI（★★★★☆，接入还需 Account ID，base_url 含账号）
CF_API_TOKEN=

# Cohere（★★★★☆，试用 Key 每月 1000 次，仅限评估）
COHERE_API_KEY=

# 智谱 GLM（★★★★☆，需手机号，免费模型会下线）
BIGMODEL_API_KEY=

# ModelScope 魔搭（★★★★☆，需绑定国内阿里云账号并实名认证）
MODELSCOPE_API_KEY=
